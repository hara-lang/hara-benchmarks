  "license": "MIT",
  "homepage": "https://hara-lang.github.io/visual-language/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hara-lang/visual-language.git"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "HARA-IMAGERY.md",
