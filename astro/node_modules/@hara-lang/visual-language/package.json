  "scripts": {
    "assets:build": "node scripts/build-motifs.mjs",
    "assets:og": "node scripts/build-og.mjs",
    "assets:raster": "node scripts/build-raster-graphics.mjs",
    "test": "npm run assets:raster && node --test test/*.test.mjs",
    "site:dev": "npm run assets:raster && ASTRO_TELEMETRY_DISABLED=1 astro dev --root site",
    "site:build": "npm run assets:raster && ASTRO_TELEMETRY_DISABLED=1 astro build --root site",
    "prepack": "npm run assets:raster"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "^5.16.0",
    "sharp": "^0.34.5"
  }
}
