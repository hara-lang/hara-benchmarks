    "V2-LEARN.md",
    "V2-WWW.md",
    "V2-GUIDE.md",
    "V2-DATA-VISUALISATION.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./motifs.css": "./src/motifs.css",
    "./effects.css": "./src/effects.css",
    "./v2.css": "./src/v2.css",
    "./v2-tool.css": "./src/v2-tool.css",
    "./v2-graphics.css": "./src/v2/graphics.css",
    "./v2-data.css": "./src/v2/data-visualisation.css",
    "./v2/frontmatter.js": "./src/v2/frontmatter.mjs",
    "./theme.js": "./src/theme.js",
    "./astro/ThemeToggle.astro": "./src/astro/ThemeToggle.astro",
    "./astro/HaraMark.astro": "./src/astro/HaraMark.astro",
    "./astro/Motif.astro": "./src/astro/Motif.astro",
    "./astro/Backdrop.astro": "./src/astro/Backdrop.astro",
    "./astro/Surface.astro": "./src/astro/Surface.astro",
