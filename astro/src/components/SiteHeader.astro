---
import ThemeToggle from "@hara-lang/ui-astro/astro/ThemeToggle.astro";
import V2Header from "@hara-lang/ui-astro/astro/v2/Header.astro";
const navigation = [
  { label: "Benchmarks", href: "/", current: true },
  { label: "Docs", href: "https://hara-lang.org/docs/", external: true },
  { label: "Build", href: "https://build.hara-lang.org/", external: true }
];
---
<V2Header
  class="benchmarks-v2-header"
  homeHref="https://hara-lang.org/"
  section="Benchmarks"
  nav={navigation}
  activePath="/"
  label="Hara Benchmarks"
  variant="document"
  accountHref="https://id.hara-lang.org/"
>
  <ThemeToggle />
</V2Header>
