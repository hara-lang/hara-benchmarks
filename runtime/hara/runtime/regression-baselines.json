{
  "schema_version": 1,
  "description": "Machine-independent relative gates. Run with the standard profile; smoke measurements are diagnostic only.",
  "rules": [
    {"runtime": "hara-rust-vm", "workload": "arithmetic", "relative_to": "bb", "max_ratio": 0.90},
    {"runtime": "hara-rust-trace-checked", "workload": "arithmetic", "relative_to": "bb", "max_ratio": 0.60},
    {"runtime": "hara-rust-trace-native", "workload": "arithmetic", "relative_to": "bb", "max_ratio": 0.10},
    {"runtime": "hara-rust-trace-native", "workload": "arithmetic", "relative_to": "hara-rust-vm", "max_ratio": 0.20},
    {"runtime": "hara-rust-trace-native", "workload": "function-call", "relative_to": "bb", "max_ratio": 0.15},
    {"runtime": "hara-rust-vm", "workload": "function-call", "relative_to": "bb", "max_ratio": 1.10},
    {"runtime": "hara-rust-vm", "workload": "persistent-vector", "relative_to": "bb", "max_ratio": 0.75},
    {"runtime": "hara-rust-trace-native", "workload": "persistent-vector", "relative_to": "bb", "max_ratio": 0.15},
    {"runtime": "hara-rust-trace-native", "workload": "persistent-vector", "relative_to": "hara-rust-vm", "max_ratio": 0.20},
    {"runtime": "hara-rust-vm", "workload": "sequence-navigation", "relative_to": "bb", "max_ratio": 0.75},
    {"runtime": "hara-rust-trace-native", "workload": "sequence-navigation", "relative_to": "hara-rust-vm", "max_ratio": 0.20}
  ]
}
