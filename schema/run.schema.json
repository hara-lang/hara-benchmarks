{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarks.hara-lang.org/schema/run.schema.json",
  "title": "Hara benchmark run",
  "type": "object",
  "required": ["schema_version", "run", "environment", "measurements"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "benchmark": {"type": ["string", "null"]},
    "issue": {"type": ["string", "null"]},
    "decision_policy": {"type": ["string", "null"]},
    "storage_model": {"type": ["string", "null"]},
    "corpus": {"type": ["string", "null"]},
    "corpus_schema_version": {"type": ["integer", "null"]},
    "run": {
      "type": "object",
      "required": ["id", "profile"],
      "properties": {
        "id": {"type": "string"},
        "profile": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "environment": {"type": "object"},
    "versions": {"type": "object"},
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite", "workload", "runtime", "status"],
        "properties": {
          "suite": {"type": "string"},
          "workload": {"type": "string"},
          "pair_id": {"type": ["string", "null"]},
          "candidate": {"type": ["string", "null"]},
          "lane": {"type": ["string", "null"]},
          "operation": {"type": ["string", "null"]},
          "value_class": {"type": ["string", "null"]},
          "representation": {"type": ["string", "null"]},
          "result_kind": {"type": ["string", "null"]},
          "runtime": {"type": "string"},
          "mode": {"enum": ["prepared", "eval"]},
          "status": {"enum": ["ok", "unsupported", "error"]},
          "reason": {"type": ["string", "null"]},
          "cold_total_ns": {"type": ["number", "null"]},
          "prepare_ns": {"type": ["number", "null"]},
          "first_call_ns": {"type": ["number", "null"]},
          "warmup_samples_ns": {"type": "array", "items": {"type": "number"}},
          "steady_state": {
            "type": "object",
            "properties": {"samples_ns": {"type": "array", "items": {"type": "number"}}}
          },
          "converged_window": {"type": ["integer", "null"]},
          "peak_rss_bytes": {"type": ["number", "null"], "minimum": 0},
          "idle_rss_bytes": {"type": ["number", "null"], "minimum": 0},
          "source_bytes": {"type": ["number", "null"], "minimum": 0},
          "artifact_bytes": {"type": ["number", "null"], "minimum": 0},
          "compressed_artifact_bytes": {"type": ["number", "null"], "minimum": 0},
          "allocation_bytes_per_call": {"type": ["number", "null"], "minimum": 0},
          "allocation_unsupported_reason": {"type": ["string", "null"]},
          "native_entry": {"type": ["boolean", "null"]},
          "execution_path": {"type": ["string", "null"]},
          "runtime_executable_bytes": {"type": ["number", "null"], "minimum": 0},
          "runtime_bundle_bytes": {"type": ["number", "null"], "minimum": 0},
          "container_image_bytes": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "candidate_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "pair_id", "split_steady_ns", "unified_steady_ns"],
        "properties": {
          "runtime": {"type": "string"},
          "pair_id": {"type": "string"},
          "lane": {"type": ["string", "null"]},
          "split_steady_ns": {"type": "number", "minimum": 0},
          "unified_steady_ns": {"type": "number", "minimum": 0},
          "unified_over_split": {"type": ["number", "null"], "minimum": 0},
          "faster_candidate": {"enum": ["split", "unified", "tie"]}
        }
      }
    }
  }
}
